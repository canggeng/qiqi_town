  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "鼠标点击进入 app，选择地面或交互点",
        "交互点分出对话与每日小游戏两条路径",
        "结果写回 GameState，再进入存档仓库"
      ]
    },
    {
      "dot": "emerald",
      "title": "内容与规则",
      "items": [
        "对话和事件由 JSON 驱动，避免把剧情写死在 UI",
        "6 套小游戏按 daily_content 编排，每天 3 个",
        "20 张贴纸、日记、友谊和主线旗标统一进 GameState"
      ]
    },
    {
      "dot": "amber",
      "title": "持久化",
      "items": [
        "20 个手动槽位 + autosave.json",
        "原子写入、.bak、损坏保护",
        "固定 %APPDATA%\\QiqiTown\\saves，支持旧目录迁移和退出自动保存"
      ]
    },
    {
      "dot": "violet",
      "title": "运行与交付",
      "items": [
        "Panda3D + DirectGUI + OpenAL 单进程运行",
        "62 个 pytest、ruff 和 smoke 作为质量门禁",
        "PyInstaller onedir + START_GAME.bat 便携交付"
      ]
    }
  ]
